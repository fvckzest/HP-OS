# Separate local HP-OS development server; remote targets are rejected.
HPOS_ORIGIN=http://127.0.0.1:3000
TEST_SITE_PORT=3100
# Copy this template to .env, or run npm run setup once to provision isolated local Sites.
# Put your local test LMNL Site-to-HP-OS credentials here. Keep all keys server-side.
# Only the local HP-OS server is allowed as an upstream target.
HPOS_SITE_API_KEY=
HPOS_OTHER_SITE_API_KEY=
HPOS_SITE_ID=
HPOS_CONNECTION_ID=
# If the local HP-OS scheduler requires a secret, configure the same value here.
CRON_SECRET=
# Optional explicit Square Sandbox + Resend profile. No production Square origin exists.
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_SANDBOX_LOCATION_ID=
# Must match the dedicated HP-OS test connection's non-secret aliases.
SQUARE_ACCOUNT_ALIAS=ref:fake-lmnl-square
SQUARE_LOCATION_ALIAS=ref:fake-lmnl-location
RESEND_API_KEY=
RESEND_FROM=
# Only this server-configured, operator-owned address can receive external email.
OPERATOR_EMAIL=
