{
  "name": "hpos",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "local": "node scripts/start-local.mjs",
    "local:stop": "node scripts/stop-local.mjs",
    "worker:local": "node scripts/local-scheduler.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "operator": "node --experimental-strip-types scripts/operator.ts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/verify-local.mjs",
    "verify:local": "node scripts/verify-local.mjs",
    "verify:notifications": "node scripts/verify-notifications.mjs",
    "verify:events": "node scripts/verify-events.mjs",
    "verify:recovery": "node scripts/verify-recovery.mjs",
    "verify:private-access": "node scripts/verify-private-access.mjs",
    "verify:historical-connections": "node scripts/verify-historical-connections.mjs",
    "verify:fees": "node scripts/verify-fee-reporting.mjs"
  },
  "dependencies": {
    "next": "16.3.6",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "supabase": "2.113.0",
    "typescript": "^5.9.0"
  }
}
